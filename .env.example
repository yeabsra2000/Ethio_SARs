# Google Gemini API key used for SAR explanations and embeddings.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# NASA Earthdata token for restricted NISAR GCOV HDF5 downloads.
# Required only for `scripts/ingest_nisar_gcov.py --download`; the committed
# demo runs without it because overlays and the manifest are already processed.
EARTHDATA_TOKEN=

# Optional overrides (defaults shown)
# GEMINI_MODEL=gemini-3.1-flash-lite
# EMBEDDING_MODEL=gemini-embedding-001
# RAG_TOP_K=3
